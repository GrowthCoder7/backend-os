{
  "name": "backend-os",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "verify:sprint2": "tsx verify-sprint2.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.7.4",
    "tsx": "^4.23.12",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "zustand": "^5.0.12"
  }
}
